{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>konflux-ci/mintmaker-presets:cve-automerge-all",
    "group:recommended"
  ],
  "schedule": ["* 0-5 */3 * *"],
  "tekton": {
    "schedule": ["* 0-5 */3 * *"]
  },
  "updateNotScheduled": false,
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 */3 * *"]
  },
  "packageRules": [
    {
      "description": "Group pyproject.toml dependency bumps; Renovate regenerates uv.lock in the same PR",
      "matchManagers": ["pep621"],
      "groupName": "python pep621"
    },
    {
      "description": "Group uv.lock refresh (transitive pins) with pep621 updates",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["lockFileMaintenance"],
      "groupName": "python pep621"
    },
    {
      "description": "Bump pinned container-build-catalog revision in pulp-tool-container PipelineRuns",
      "matchManagers": ["tekton"],
      "matchFileNames": [".tekton/pulp-tool-container-build-*.yaml"],
      "groupName": "tekton container-build-catalog"
    }
  ]
}
