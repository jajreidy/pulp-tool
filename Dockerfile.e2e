# E2e test runner image for Konflux pulp-e2e-testing pipeline.
# Pre-installs dependencies shared across all e2e Tekton steps.
# Base image: UBI 10 minimal (system python3 is 3.12)

# ORAS CLI + select-oci-auth (Konflux release-service-utils pattern).
FROM quay.io/konflux-ci/oras:latest@sha256:1cc659b4d30536ec98300ac551739ef36dee345a7dcfe06129fd78abdc3688ac AS oras

FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2-1789645153

# Skip microdnf update — metadata refresh is a common Konflux failure point.
# rust/cargo/gcc/python3-devel: build rpm-rs from sdist when no wheel matches (e.g. arm64).
RUN microdnf install -y \
        python3 \
        python3-pip \
        gcc \
        python3-devel \
        rust \
        cargo && \
    microdnf clean all

COPY e2e/requirements.txt /opt/e2e/requirements.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir --root-user-action=ignore \
        -r /opt/e2e/requirements.txt && \
    pulp --version && \
    python3 -c "import rpm_rs"

COPY --from=oras /usr/bin/oras /usr/bin/oras
COPY --from=oras /usr/bin/yq /usr/bin/yq
COPY --from=oras /usr/local/bin/select-oci-auth /usr/local/bin/select-oci-auth
COPY --from=oras /usr/local/bin/get-reference-base /usr/local/bin/get-reference-base
RUN oras version && yq --version && test -x /usr/local/bin/select-oci-auth && test -x /usr/local/bin/get-reference-base

WORKDIR /workspace
