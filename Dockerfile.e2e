# E2e test runner image for Konflux pulp-e2e-testing pipeline.
# Pre-installs dependencies shared across all e2e Tekton steps.
# Base image: UBI 10 minimal (system python3 is 3.12)
FROM registry.access.redhat.com/ubi10/ubi-minimal:10.2-1787688243

RUN microdnf update -y && \
    microdnf install -y \
        python3 \
        python3-pip \
        gcc \
        python3-devel \
    && microdnf clean all && \
    pip3 install --no-cache-dir --root-user-action=ignore \
        pulp-cli \
        "rpm-rs<0.25"

WORKDIR /workspace
